{
  "$schema": "https://app.kilo.ai/config.json",
  "mcpServers": {
    "vapi-mcp": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.vapi.ai/mcp",
        "--header",
        "Authorization: Bearer ${VAPI_TOKEN}"
      ],
      "env": {}
    },
    "vapi-docs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://docs.vapi.ai/_mcp/server"
      ]
    }
  }
}